# Credenciais do projeto Supabase (Project Settings > API). Obrigatórias: sem
# elas o servidor não inicia. SUPABASE_KEY é a chave "anon public"; o banco só
# é acessado pelo backend Express. Nunca versione o .env com valores reais.
SUPABASE_URL=
SUPABASE_KEY=

# Porta em que o servidor escuta. Plataformas de deploy em nuvem (Render,
# Railway, etc.) injetam essa variável automaticamente; em execução local ela
# é opcional (padrão: 3001).
PORT=3001

# Client ID OAuth 2.0 do Google (Google Cloud Console > APIs e Serviços >
# Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web"), necessário
# para o botão "Entrar com o Google" (Google Identity Services) funcionar.
# Sem esta variável, o botão aparece desabilitado no login. Origens autorizadas:
# http://localhost:3001 e o domínio da Vercel (passo a passo no README).
GOOGLE_CLIENT_ID=

# Defina como 1 se o servidor roda atrás de um proxy reverso (Render, Railway,
# nginx...) para que o IP do cliente seja lido corretamente. Na Vercel já é
# automático.
TRUST_PROXY=

# Senha da conta de RH de testes (rh@onboarding.local), semeada no boot.
# Opcional: se ficar vazia, vale a senha padrão pública (onboarding123,
# documentada no README, para que qualquer pessoa possa testar). Definindo um
# valor aqui, ele passa a valer também para uma conta de RH já existente.
SENHA_RH_TESTE=

# Chave da API REST v1 (GET /api/v1/admissoes), enviada no header "x-api-key".
# Obrigatória para usar a API (mín. 16 caracteres, valor longo e aleatório);
# se ficar vazia, a API responde 503 - não existe chave padrão.
API_KEY_ADMISSOES=
